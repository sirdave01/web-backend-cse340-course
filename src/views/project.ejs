<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.title %>
        </h2>

        <p><strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' })
                %>
        </p>

        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p><strong>Partner Organization:</strong>

            <a href="/organizations/<%= project.organization_id %>">

                <%= project.organization_name %>

            </a>
        </p>

        <h3>Description</h3>
        <p>
            <%= project.description %>
        </p>

        <!-- Categories / Tags -->
        <% if (categories && categories.length> 0) { %>

            <h3>Categories</h3>

            <ul class="list-cards chips">

                <% categories.forEach(cat=> { %>

                    <li>

                        <a href="/categories/<%= cat.category_id %>">

                            <%= cat.category_name %>

                        </a>

                    </li>

                    <% }); %>
            </ul>
            <% } %>

                <!-- Volunteer Section -->
                <div class="volunteer-section">

                    <% if (user) { %>

                        <% if (isVolunteering) { %>

                            <div class="volunteer-status success">

                                <p><strong>✓ You are volunteering for this project!</strong></p>

                                <p>Thank you for your commitment to this service project.</p>

                            </div>

                            <form action="/project/<%= project.project_id %>/volunteer/remove" method="POST"
                                class="inline-form">

                                <button type="submit" class="btn btn-danger">

                                    Remove Yourself as Volunteer

                                </button>

                            </form>

                            <% } else { %>

                                <p><strong>Interested in volunteering?</strong></p>

                                <form action="/project/<%= project.project_id %>/volunteer" method="POST"
                                    class="inline-form">

                                    <button type="submit" class="btn btn-primary">

                                        Sign Up to Volunteer

                                    </button>

                                </form>

                                <% } %>

                                    <% } else { %>

                                        <p><strong>Want to volunteer?</strong>

                                            <a href="/login">Log in</a> or

                                            <a href="/register">register</a>

                                            to sign up for this project.

                                        </p>

                                        <% } %>

                </div>

                <% if (isAdmin) { %>
                    <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
                <% } %>

    </main>

    <%- include('partials/footer') %>