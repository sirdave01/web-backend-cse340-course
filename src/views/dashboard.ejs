<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <!-- displays the user's name and email address. You can assume the name and email address are stored in name and email
        variables that you will set in your controller -->

        <h2> Dashboard</h2>

        <p>Name: <%= name %></p>

        <p>Email: <%= email %></p>

        <a href="/users">View All Users</a>

        <!-- Volunteered Projects Section -->
        <section class="volunteered-projects" style="margin-top: 40px;">
            <h2>My Volunteer Projects</h2>

            <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
                <p>You are currently volunteering for <strong><%= volunteeredProjects.length %></strong> project(s):</p>
                
                <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                    <thead>
                        <tr style="background-color: #f0f0f0; border-bottom: 2px solid #333;">
                            <th style="padding: 10px; text-align: left;">Project Title</th>
                            <th style="padding: 10px; text-align: left;">Organization</th>
                            <th style="padding: 10px; text-align: left;">Date</th>
                            <th style="padding: 10px; text-align: left;">Location</th>
                            <th style="padding: 10px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% volunteeredProjects.forEach(project => { %>
                            <tr style="border-bottom: 1px solid #ddd;">
                                <td style="padding: 10px;">
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </td>
                                <td style="padding: 10px;">
                                    <a href="/organizations/<%= project.organization_id %>">
                                        <%= project.organization_name %>
                                    </a>
                                </td>
                                <td style="padding: 10px;">
                                    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                </td>
                                <td style="padding: 10px;">
                                    <%= project.location %>
                                </td>
                                <td style="padding: 10px; text-align: center;">
                                    <form action="/project/<%= project.project_id %>/volunteer/remove" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-danger" style="padding: 8px 12px; background-color: #e74c3c; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;">
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color: #666; font-style: italic;">
                    You are not currently volunteering for any projects. 
                    <a href="/projects">View available projects</a> to get started!
                </p>
            <% } %>
        </section>

    </main>

        <%- include('partials/footer') %>